---
import { obtenerAliados } from "../../lib/api-publica";
import SectionHeading from "../ui/section-heading.astro";

const allies = await obtenerAliados();
---

{
  allies.length > 0 && (
    <section class="bg-subtle py-12 sm:py-16">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <SectionHeading
          title="Aliados"
          subtitle="Organizaciones y comunidades que caminan junto a nosotros."
        />

        <ul class="mt-12 flex flex-wrap items-center justify-center gap-4">
          {allies.map((ally) => {
            const content = (
              <span class="block text-center">
                <span class="block font-semibold text-content">
                  {ally.nombre}
                </span>
                {ally.usuarioRedes && (
                  <span class="block text-sm text-content/60">
                    {ally.usuarioRedes}
                  </span>
                )}
              </span>
            );

            return (
              <li>
                {ally.enlace ? (
                  <a
                    href={ally.enlace}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block rounded-2xl border border-line bg-surface px-6 py-4 shadow-sm transition-shadow hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
                  >
                    {content}
                  </a>
                ) : (
                  <div class="rounded-2xl border border-line bg-surface px-6 py-4 shadow-sm">
                    {content}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
