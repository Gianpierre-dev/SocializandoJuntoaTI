---
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";
import { obtenerBanners } from "../../lib/api-publica";
import Button from "../ui/button.astro";

const banners = await obtenerBanners();

// Estilos por variante para banners sin imagen.
const variantClasses = {
  brand: "bg-brand text-white",
  gold: "bg-gold text-brand-deep",
  green: "bg-green text-brand-deep",
} as const;

// Blanco sobre morado: el dorado no alcanzaba 4.5:1 de contraste.
const kickerClasses = {
  brand: "text-white/95",
  gold: "text-brand-deep",
  green: "text-brand-deep",
} as const;

const ctaVariants = {
  brand: "gold",
  gold: "primary",
  green: "primary",
} as const;
---

{
  banners.length > 0 && (
    <section
      class="bg-page py-6"
      aria-roledescription="carrusel"
      aria-label="Banners destacados"
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div
          id="hero-carousel"
          class="flex snap-x snap-mandatory overflow-x-auto scroll-smooth rounded-xl shadow-md [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {banners.map((banner, index) => {
            // El primer banner lleva el h1 de la portada.
            const Titulo = index === 0 ? "h1" : "p";
            return (
              <div
                class="w-full shrink-0 snap-center"
                role="group"
                aria-roledescription="banner"
                aria-label={`${index + 1} de ${banners.length}`}
              >
                {banner.imagenUrl ? (
                  <a
                    href={banner.enlace}
                    class="relative block aspect-[10/3] overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-brand"
                  >
                    {/* Fondo difuminado: rellena el marco sin recortar la imagen real */}
                    <img
                      src={banner.imagenUrl}
                      alt=""
                      aria-hidden="true"
                      loading={index === 0 ? "eager" : "lazy"}
                      class="absolute inset-0 h-full w-full scale-110 object-cover opacity-50 blur-xl"
                    />
                    <img
                      src={banner.imagenUrl}
                      alt={banner.textoAlternativo ?? banner.titulo}
                      width="1940"
                      height="582"
                      loading={index === 0 ? "eager" : "lazy"}
                      class="relative h-full w-full object-contain"
                    />
                  </a>
                ) : (
                  <div
                    class={`grid h-full items-center gap-6 px-6 py-10 sm:grid-cols-[1fr_auto] sm:px-14 sm:py-16 ${variantClasses[banner.variante]}`}
                  >
                    <div>
                      <p
                        class={`text-xs font-bold uppercase tracking-widest ${kickerClasses[banner.variante]}`}
                      >
                        {banner.etiqueta}
                      </p>
                      <Titulo class="mt-3 text-2xl font-bold leading-tight sm:text-4xl">
                        {banner.titulo}
                      </Titulo>
                      {banner.descripcion && (
                        <p class="mt-4 max-w-xl text-sm opacity-90 sm:text-base">
                          {banner.descripcion}
                        </p>
                      )}
                    </div>
                    {banner.textoBoton ? (
                      <Button
                        href={banner.enlace}
                        variant={ctaVariants[banner.variante]}
                        label={banner.textoBoton}
                      />
                    ) : (
                      <div class="hidden sm:block">
                        <Image
                          src={logo}
                          alt=""
                          width={176}
                          height={176}
                          class="h-44 w-44 object-contain drop-shadow-lg"
                        />
                      </div>
                    )}
                  </div>
                )}
              </div>
            );
          })}
        </div>

        {/* Indicadores: punto visual de 12px dentro de un área táctil de 44px */}
        <div class="mt-2 flex justify-center" role="tablist">
          {banners.map((banner, index) => (
            <button
              type="button"
              class="hero-dot group flex h-11 w-11 items-center justify-center focus-visible:outline-none"
              data-active={index === 0 ? "" : undefined}
              aria-label={`Ir al banner: ${banner.titulo}`}
            >
              <span
                class="h-3 w-3 rounded-full bg-content/25 transition-colors group-hover:bg-brand/60 group-focus-visible:ring-2 group-focus-visible:ring-brand group-[[data-active]]:bg-brand"
                aria-hidden="true"
              />
            </button>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  const carousel = document.getElementById("hero-carousel");
  const dots = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".hero-dot"),
  );

  if (carousel && dots.length > 0) {
    let index = 0;
    let timer: number | undefined;

    const goTo = (i: number) => {
      index = (i + dots.length) % dots.length;
      carousel.scrollTo({
        left: carousel.clientWidth * index,
        behavior: "smooth",
      });
    };

    const syncDots = () => {
      const current = Math.round(carousel.scrollLeft / carousel.clientWidth);
      dots.forEach((dot, i) => {
        if (i === current) dot.setAttribute("data-active", "");
        else dot.removeAttribute("data-active");
      });
      index = current;
    };

    const startAuto = () => {
      stopAuto();
      // Respeta la preferencia de movimiento reducido.
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
        return;
      timer = window.setInterval(() => goTo(index + 1), 6000);
    };

    const stopAuto = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        goTo(i);
        startAuto();
      });
    });

    carousel.addEventListener("scroll", () => {
      window.requestAnimationFrame(syncDots);
    });
    carousel.addEventListener("pointerenter", stopAuto);
    carousel.addEventListener("pointerleave", startAuto);
    carousel.addEventListener("focusin", stopAuto);
    carousel.addEventListener("focusout", startAuto);

    startAuto();
  }
</script>
