---
import { obtenerSitio } from "../../lib/sitio";

const site = await obtenerSitio();
import Button from "../ui/button.astro";

const previewRequirements = site.requirements.slice(0, 4);
const formHref = "/voluntariado#postular";
---

<section class="relative overflow-hidden bg-brand-deep py-20 text-white sm:py-28">
  <!-- Textura sutil de puntos -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.06] [background-image:radial-gradient(white_1.2px,transparent_1.2px)] [background-size:22px_22px]"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
    <h2 class="text-3xl font-bold sm:text-4xl">Sé parte del cambio</h2>
    <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg">
      Únete como voluntario y ayuda a construir espacios seguros para el
      bienestar emocional de más jóvenes.
    </p>

    {
      previewRequirements.length > 0 && (
        <ul class="mx-auto mt-8 grid max-w-2xl gap-3 text-left sm:grid-cols-2">
          {previewRequirements.map((requirement) => (
            <li class="flex items-start gap-2.5 text-sm leading-relaxed text-white/90">
              <span
                class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-gold text-xs font-bold text-brand-deep"
                aria-hidden="true"
              >
                &#10003;
              </span>
              {requirement}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-10">
      <Button href={formHref} variant="gold" label="Quiero ser voluntario" />
    </div>
  </div>
</section>
