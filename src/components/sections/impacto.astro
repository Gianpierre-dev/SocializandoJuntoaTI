---
// Cifras de impacto y testimonios: se muestran solo si hay contenido cargado
// desde el panel (secciones "Cifras de impacto" y "Testimonios").
import { obtenerCifras, obtenerTestimonios } from "../../lib/api-publica";

const [cifras, testimonios] = await Promise.all([
  obtenerCifras(),
  obtenerTestimonios(),
]);
---

{
  cifras.length > 0 && (
    <section class="bg-surface py-12 sm:py-16" aria-label="Nuestro impacto">
      <div class="mx-auto max-w-5xl px-4 sm:px-6">
        <ul class="grid gap-6 text-center sm:grid-cols-3">
          {cifras.map((cifra) => (
            <li>
              <p class="text-4xl font-bold text-accent sm:text-5xl">
                {cifra.valor}
              </p>
              <p class="mt-2 text-sm font-medium leading-relaxed text-content/70">
                {cifra.etiqueta}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

{
  testimonios.length > 0 && (
    <section
      class="bg-subtle py-16 sm:py-20"
      aria-label="Testimonios de participantes"
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="text-center text-3xl font-bold text-content sm:text-4xl">
          Lo que dicen quienes participan
        </h2>
        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {testimonios.map((testimonio) => (
            <li class="flex h-full flex-col rounded-2xl border border-line bg-surface p-6 shadow-sm">
              <p
                class="flex-1 text-base italic leading-relaxed text-content/80"
                lang="es"
              >
                «{testimonio.texto}»
              </p>
              <div class="mt-5 flex items-center gap-3 border-t border-line pt-4">
                {testimonio.fotoUrl ? (
                  <img
                    src={testimonio.fotoUrl}
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                    class="h-12 w-12 rounded-full object-cover"
                  />
                ) : (
                  <span
                    class="flex h-12 w-12 items-center justify-center rounded-full bg-brand/10 text-lg font-semibold text-accent"
                    aria-hidden="true"
                  >
                    {testimonio.autor.trim().charAt(0).toUpperCase()}
                  </span>
                )}
                <span>
                  <span class="block font-semibold text-content">
                    {testimonio.autor}
                  </span>
                  {testimonio.detalle && (
                    <span class="block text-sm text-content/60">
                      {testimonio.detalle}
                    </span>
                  )}
                </span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
