---
interface Props {
  title: string;
  subtitle?: string;
  /** Nivel del heading: "h1" para el título principal de la página. */
  nivel?: "h1" | "h2";
}

const { title, subtitle, nivel = "h2" } = Astro.props;
const Encabezado = nivel;
---

<div class="mx-auto max-w-2xl text-center">
  <Encabezado class="text-3xl font-bold text-content sm:text-4xl">
    {title}
  </Encabezado>
  {
    subtitle && (
      <p class="mt-4 text-base leading-relaxed text-content/70 sm:text-lg">
        {subtitle}
      </p>
    )
  }
</div>
