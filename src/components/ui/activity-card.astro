---
interface Props {
  title: string;
  summary: string;
  cost: string;
  modality: "presencial" | "online" | "mixto";
  status: "active" | "in-development";
  duracion?: string | null;
  frecuencia?: string | null;
  imagenUrl?: string | null;
  textoAlternativo?: string | null;
}

const {
  title,
  summary,
  cost,
  modality,
  status,
  duracion,
  frecuencia,
  imagenUrl,
  textoAlternativo,
} = Astro.props;

const modalityLabels: Record<Props["modality"], string> = {
  presencial: "Presencial",
  online: "En línea",
  mixto: "Mixto",
};

const isComingSoon = status === "in-development";
---

<article
  class={`flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-sm transition-shadow duration-200 hover:shadow-md ${
    isComingSoon ? "opacity-70" : ""
  }`}
>
  {
    imagenUrl && (
      <img
        src={imagenUrl}
        alt={textoAlternativo ?? `Actividad: ${title}`}
        width="1200"
        height="800"
        loading="lazy"
        class="aspect-[3/2] w-full object-cover"
      />
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <span
        class="rounded-full bg-green/15 px-3 py-1 text-xs font-semibold text-green"
      >
        {modalityLabels[modality]}
      </span>
      {
        isComingSoon && (
          <span class="rounded-full bg-gold/15 px-3 py-1 text-xs font-semibold text-gold">
            Próximamente
          </span>
        )
      }
    </div>

    <h3 class="text-lg font-semibold text-content">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-content/70">
      {summary}
    </p>

    {
      (duracion || frecuencia) && (
        <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-content/60">
          {duracion && <span>⏱ {duracion}</span>}
          {frecuencia && <span>📅 {frecuencia}</span>}
        </p>
      )
    }

    <p class="mt-4 text-sm font-semibold text-accent">
      <span class="text-content/60">Costo:</span>
      {cost}
    </p>
  </div>
</article>
