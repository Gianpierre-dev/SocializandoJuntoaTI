---
// Formulario de postulación: 7 campos esenciales, validación accesible y
// envío a la API del backend. Lo demás se conversa en la entrevista.
import { site } from "../../data/site";
import { API_PUBLICA_URL } from "../../lib/api-publica";
import SectionHeading from "../ui/section-heading.astro";

const DISPONIBILIDADES = [
  "Fines de semana (3 a 5 horas)",
  "Entre semana",
  "Horario flexible",
];

const claseInput =
  "mt-1 w-full rounded-xl border border-line bg-surface px-3.5 py-2.5 text-base text-content transition-shadow focus:outline-none focus:ring-2 focus:ring-brand aria-[invalid]:border-red-500";
---

<section class="bg-surface py-16 sm:py-20" id="postular">
  <div class="mx-auto max-w-2xl px-4 sm:px-6">
    <SectionHeading
      title="Postula aquí"
      subtitle="Completa estos datos y te contactamos por WhatsApp para conversar. Toma menos de 2 minutos."
    />

    <form id="form-voluntariado" class="mt-10 space-y-5" novalidate>
      <div class="grid gap-5 sm:grid-cols-[1fr_8rem]">
        <div>
          <label for="campo-nombre" class="block text-sm font-medium text-content">
            Nombre completo
          </label>
          <input
            id="campo-nombre"
            name="nombre"
            type="text"
            autocomplete="name"
            required
            minlength="3"
            class={claseInput}
          />
          <p class="mt-1 hidden text-sm text-red-600" data-error-para="campo-nombre"></p>
        </div>
        <div>
          <label for="campo-edad" class="block text-sm font-medium text-content">
            Edad
          </label>
          <input
            id="campo-edad"
            name="edad"
            type="number"
            inputmode="numeric"
            min="14"
            max="99"
            required
            class={claseInput}
          />
          <p class="mt-1 hidden text-sm text-red-600" data-error-para="campo-edad"></p>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="campo-correo" class="block text-sm font-medium text-content">
            Correo electrónico
          </label>
          <input
            id="campo-correo"
            name="correo"
            type="email"
            autocomplete="email"
            required
            class={claseInput}
          />
          <p class="mt-1 hidden text-sm text-red-600" data-error-para="campo-correo"></p>
        </div>
        <div>
          <label for="campo-celular" class="block text-sm font-medium text-content">
            Celular (WhatsApp)
          </label>
          <input
            id="campo-celular"
            name="celular"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            minlength="9"
            class={claseInput}
          />
          <p class="mt-1 hidden text-sm text-red-600" data-error-para="campo-celular"></p>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="campo-area" class="block text-sm font-medium text-content">
            Área de interés
          </label>
          <select id="campo-area" name="area" required class={claseInput}>
            <option value="">Selecciona un área</option>
            {site.areas.map((area) => (
              <option value={area.title}>{area.title}</option>
            ))}
            <option value="No estoy seguro/a">
              No estoy seguro/a, oriéntenme
            </option>
          </select>
          <p class="mt-1 hidden text-sm text-red-600" data-error-para="campo-area"></p>
        </div>
        <div>
          <label
            for="campo-disponibilidad"
            class="block text-sm font-medium text-content"
          >
            Disponibilidad
          </label>
          <select
            id="campo-disponibilidad"
            name="disponibilidad"
            required
            class={claseInput}
          >
            <option value="">Selecciona tu disponibilidad</option>
            {DISPONIBILIDADES.map((opcion) => (
              <option value={opcion}>{opcion}</option>
            ))}
          </select>
          <p
            class="mt-1 hidden text-sm text-red-600"
            data-error-para="campo-disponibilidad"
          ></p>
        </div>
      </div>

      <div>
        <label for="campo-mensaje" class="block text-sm font-medium text-content">
          Cuéntanos de ti <span class="text-content/50">(opcional)</span>
        </label>
        <textarea
          id="campo-mensaje"
          name="mensaje"
          rows="3"
          maxlength="1000"
          placeholder="¿Por qué te interesa el voluntariado? ¿Qué te gustaría aportar?"
          class={claseInput}></textarea>
      </div>

      <!-- Honeypot antispam: oculto para personas, tentador para bots -->
      <div class="absolute left-[-9999px]" aria-hidden="true">
        <label for="campo-sitio">No completes este campo</label>
        <input id="campo-sitio" name="sitio" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <p
        id="error-general"
        role="alert"
        class="hidden rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700"
      >
      </p>

      <button
        type="submit"
        id="boton-enviar"
        class="w-full rounded-xl bg-gold px-6 py-3.5 text-base font-semibold text-brand-deep transition-colors hover:bg-gold/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2 disabled:opacity-50 sm:w-auto"
      >
        Enviar postulación
      </button>
      <p class="text-xs leading-relaxed text-content/50">
        Usaremos tus datos solo para contactarte sobre el voluntariado.
      </p>
    </form>

    <div
      id="mensaje-exito"
      role="status"
      class="mt-10 hidden rounded-2xl border border-green/30 bg-green/10 p-8 text-center"
    >
      <p class="text-2xl font-bold text-content">¡Postulación recibida! 💜</p>
      <p class="mx-auto mt-3 max-w-md leading-relaxed text-content/70">
        Gracias por querer sumarte. Nuestro equipo de Recursos Humanos te
        escribirá por WhatsApp en los próximos días para coordinar una
        conversación. Mientras tanto, síguenos en redes para conocernos más.
      </p>
    </div>
  </div>
</section>

<script define:vars={{ apiUrl: API_PUBLICA_URL }}>
  const form = document.getElementById("form-voluntariado");
  const errorGeneral = document.getElementById("error-general");
  const exito = document.getElementById("mensaje-exito");
  const botonEnviar = document.getElementById("boton-enviar");

  const MENSAJES = {
    "campo-nombre": "Escribe tu nombre completo (mínimo 3 letras).",
    "campo-edad": "Ingresa tu edad (entre 14 y 99).",
    "campo-correo": "Ingresa un correo válido.",
    "campo-celular": "Ingresa tu celular (mínimo 9 dígitos).",
    "campo-area": "Selecciona un área de interés.",
    "campo-disponibilidad": "Selecciona tu disponibilidad.",
  };

  const limpiarErrores = () => {
    errorGeneral.classList.add("hidden");
    form.querySelectorAll("[data-error-para]").forEach((p) => {
      p.classList.add("hidden");
      p.textContent = "";
    });
    form
      .querySelectorAll("[aria-invalid]")
      .forEach((campo) => campo.removeAttribute("aria-invalid"));
  };

  const marcarError = (campo, mensaje) => {
    campo.setAttribute("aria-invalid", "true");
    const p = form.querySelector(`[data-error-para="${campo.id}"]`);
    if (p) {
      p.textContent = mensaje;
      p.classList.remove("hidden");
      campo.setAttribute("aria-describedby", `${campo.id}-error`);
      p.id = `${campo.id}-error`;
    }
  };

  form?.addEventListener("submit", async (evento) => {
    evento.preventDefault();
    limpiarErrores();

    // Honeypot: si un bot lo llenó, fingimos éxito sin enviar nada.
    if (form.elements.sitio.value) {
      form.classList.add("hidden");
      exito.classList.remove("hidden");
      return;
    }

    // Validación visible y accesible, campo por campo.
    let primerInvalido = null;
    for (const id of Object.keys(MENSAJES)) {
      const campo = document.getElementById(id);
      if (!campo.checkValidity()) {
        marcarError(campo, MENSAJES[id]);
        primerInvalido = primerInvalido ?? campo;
      }
    }
    if (primerInvalido) {
      primerInvalido.focus();
      return;
    }

    botonEnviar.disabled = true;
    botonEnviar.textContent = "Enviando…";

    try {
      const respuesta = await fetch(`${apiUrl}/api/postulaciones`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          nombre: form.elements.nombre.value.trim(),
          edad: Number(form.elements.edad.value),
          correo: form.elements.correo.value.trim(),
          celular: form.elements.celular.value.trim(),
          area: form.elements.area.value,
          disponibilidad: form.elements.disponibilidad.value,
          mensaje: form.elements.mensaje.value.trim() || undefined,
        }),
      });

      if (!respuesta.ok) throw new Error(`Error ${respuesta.status}`);

      form.classList.add("hidden");
      exito.classList.remove("hidden");
      exito.focus?.();
      exito.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch {
      errorGeneral.textContent =
        "No pudimos enviar tu postulación. Revisa tu conexión e inténtalo de nuevo; si persiste, escríbenos por Instagram.";
      errorGeneral.classList.remove("hidden");
    } finally {
      botonEnviar.disabled = false;
      botonEnviar.textContent = "Enviar postulación";
    }
  });
</script>
